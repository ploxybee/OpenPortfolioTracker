# Leave these blank to use the safe demo portfolio.
# PostgreSQL is required. Run `make db-migrate` after configuring this value.
DATABASE_URL=postgres://portfolio:password@localhost:5432/portfolio?sslmode=disable
TIGER_ID=
# Quote multi-line keys using literal \n characters.
TIGER_PRIVATE_KEY=
TIGER_ACCOUNT=
# Usually TBNZ; use the license shown in Tiger Open Platform.
TIGER_LICENSE=TBNZ
# Set true only when the IBKR Client Portal Gateway runs on this same host.
# Trust its locally-issued TLS certificate; never disable certificate validation.
IBKR_ENABLED=false
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_GATEWAY_CA_FILE=
# All portfolio values and stored history use SGD. Other values are rejected.
PORTFOLIO_BASE_CURRENCY=SGD
# Allocation targets must total 100. Empty values use the defaults shown here.
PORTFOLIO_TARGETS=Equities=100
PORTFOLIO_REBALANCE_TOLERANCE=5
PORTFOLIO_MONTHLY_CONTRIBUTION=0
