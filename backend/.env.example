# Leave these blank to use the safe demo portfolio.
TIGER_ID=
# Quote multi-line keys using literal \n characters.
TIGER_PRIVATE_KEY=
TIGER_ACCOUNT=
# Usually TBNZ; use the license shown in Tiger Open Platform.
TIGER_LICENSE=TBNZ
# Your Tiger account's primary currency. Tiger's assets endpoint supplies conversion rates to it.
PORTFOLIO_BASE_CURRENCY=USD
# Allocation targets must total 100. Empty values use the defaults shown here.
PORTFOLIO_TARGETS=Equities=100
PORTFOLIO_REBALANCE_TOLERANCE=5
PORTFOLIO_MONTHLY_CONTRIBUTION=0
